# Copy this file to .env.local for local testing (never commit the real one).
# In production, set these as Environment Variables in the Vercel dashboard instead.

# Supabase → Project Settings → API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Your own values — pick a strong password and a long random secret
ADMIN_PASSWORD=choose-a-strong-admin-password
ADMIN_SECRET=a-long-random-string-used-to-sign-admin-session-tokens
